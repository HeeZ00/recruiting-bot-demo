# Anthropic API 키 (https://console.anthropic.com 에서 발급)
# 복사해서 .env 로 저장한 뒤 실제 키를 넣으세요.
ANTHROPIC_API_KEY=sk-ant-...

# (선택) 모델 오버라이드. 미설정 시 claude-opus-4-8 사용.
# JD_BOT_MODEL=claude-opus-4-8

# (선택) 경쟁사 실시간 웹 리서치 끄기: false 로 두면 웹서치 없이 요청서만으로 작성
# JD_BOT_WEB_SEARCH=true

# ===== 웹 화면 → 슬랙 알림용 (가장 간단) =====
# 슬랙 채널에 Incoming Webhook 만들고 URL 붙여넣기 (봇 토큰/스코프 불필요)
# 만들기: api.slack.com/apps → Incoming Webhooks → Add New Webhook to Workspace
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ===== 슬랙 챗봇 앱(별도)용 — 웹 화면만 쓸 거면 비워둬도 됨 =====
# Slack 앱 생성 후 발급: api.slack.com/apps
# SLACK_BOT_TOKEN=xoxb-...        # Bot User OAuth Token
# SLACK_APP_TOKEN=xapp-...        # App-Level Token (Socket Mode, connections:write)
# SLACK_SIGNING_SECRET=...        # Basic Information > Signing Secret
